# Optional HTTPS for opening the compose stack from other devices
# (`--profile https`). Browsers allow the app's encryption only on secure
# pages, so plain http:// works only on the machine itself (localhost).
# `tls internal` uses Caddy's own certificate authority: browsers warn once.
{$CHAT_HOST} {
	tls internal
	# Tell browsers to use HTTPS only for this host (one year, no subdomains:
	# other hosts may have no certificate).
	header Strict-Transport-Security "max-age=31536000"
	# LiveKit signalling for group calls (CHAT_LIVEKIT_URL=wss://<CHAT_HOST>:8443).
	# The app only calls /rtc from its own origin. LiveKit reflects any request
	# Origin in its CORS headers, so drop them here.
	header /rtc* {
		-Access-Control-Allow-Origin
		-Access-Control-Allow-Credentials
		-Access-Control-Allow-Methods
		-Access-Control-Allow-Headers
		-Access-Control-Expose-Headers
	}
	reverse_proxy /rtc* livekit:7880
	reverse_proxy web:8080
}
