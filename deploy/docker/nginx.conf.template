# Rendered by the nginx image's envsubst step at container start.
server {
    listen 8080;
    root /usr/share/nginx/html;

    location = /healthz {
        access_log off;
        return 200 "ok";
    }

    # Content-hashed build output never changes.
    location /assets/ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Map tiles (ADR-0026): one PMTiles file read by byte range, mounted at
    # /srv/tiles. Missing means no basemap: locations still show, without a map.
    location /tiles/ {
        include /etc/nginx/conf.d/security-headers.inc;
        alias /srv/tiles/;
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # The service worker and app shell must always be revalidated.
    location ~ ^/(sw\.js|manifest\.webmanifest)$ {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/conf.d/security-headers.inc;
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
